datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password      String
  name          String?
  createdAt     DateTime        @default(now())
  watchlist     WatchlistItem[]
}

model Movie {
  id               String          @id @default(uuid())
  tmdbId           Int             @unique
  title            String
  type             String          // "movie" ou "tv"
  posterPath       String?
  releaseYear      String?
  genreIds         String?         // Ex: "16,28"
  originalLanguage String?         // Ex: "ja", "en"
  watchlist        WatchlistItem[]
}

// --- NOUVEAUX MODÈLES ---

model Book {
  id            String          @id @default(uuid())
  googleId      String          @unique
  title         String
  authors       String?
  posterPath    String?
  publishedDate String?
  watchlist     WatchlistItem[]
}

model Game {
  id            String          @id @default(uuid())
  rawgId        Int             @unique
  title         String
  developers    String?
  posterPath    String?
  releaseDate   String?
  watchlist     WatchlistItem[]
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  
  // Relations optionnelles (Un item est SOIT un film, SOIT un livre, SOIT un jeu)
  movieId   String?
  bookId    String?
  gameId    String?

  status    String   // "PAV", "VU"
  ranking   String?  // "DIAMOND", "GOLD", etc.
  addedAt   DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
}
